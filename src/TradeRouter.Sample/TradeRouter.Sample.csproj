<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>TradeRouter.Sample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Consumers of the published packages replace these with:
         <PackageReference Include="TradeRouter.Net" Version="2.10.0" />
         <PackageReference Include="TradeRouter.Net.Caching" Version="2.10.0" /> -->
    <ProjectReference Include="..\TradeRouter\TradeRouter.csproj" />
    <ProjectReference Include="..\TradeRouter.Caching\TradeRouter.Caching.csproj" />
    <!-- In-memory IDistributedCache for example 18; an application registers Redis, SQL Server or PostgreSQL instead. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
  </ItemGroup>

</Project>
