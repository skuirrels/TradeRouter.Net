<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TradeRouter.Net</PackageId>
    <Version>2.0.0</Version>
    <Authors>eDC team</Authors>
    <Description>High-performance .NET maritime shortest-path routing library based on Eurostat marnet data.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/skuirrels/TradeRouter.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/skuirrels/TradeRouter.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>maritime;searoute;routing;geospatial;ports;geojson;dijkstra;eurostat</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\*.gz" />
    <EmbeddedResource Include="Data\unlocode-supplement.json" />
    <EmbeddedResource Include="Data\unlocode-seaport-supplement.json" />
    <EmbeddedResource Include="Data\port-code-aliases.json" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\DATA_PROVENANCE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\**\*" Exclude="..\..\docs\.DS_Store" Pack="true" PackagePath="docs\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\tools\*.py" Pack="true" PackagePath="tools\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
